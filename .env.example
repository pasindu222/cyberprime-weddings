# Copy to .env.local and fill in.

# Public URL of the deployed invitation. Used for Open Graph (WhatsApp preview) absolute URLs.
# On Vercel this is detected automatically, but set it if you use a custom domain.
NEXT_PUBLIC_SITE_URL=https://kasun-dilini.example.com

# Optional: where RSVPs are sent (Google Apps Script web app, Zapier, Make, n8n...).
# If empty, RSVPs are appended to ./data/rsvps.jsonl (works locally / on a VPS, NOT on Vercel).
RSVP_WEBHOOK_URL=
